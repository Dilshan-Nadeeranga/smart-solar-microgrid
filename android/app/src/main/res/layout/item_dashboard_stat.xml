<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="6dp"
    android:background="@drawable/bg_dashboard_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_solar_icon_circle"
        android:gravity="center"
        android:text="⚡"
        android:textColor="@color/solar_yellow"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvStatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/dashboard_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dashboard_text"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
