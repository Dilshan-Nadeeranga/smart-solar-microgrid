<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solarix_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/solarix_header" />

    <LinearLayout
        android:id="@+id/activityContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="168dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/solarix_brand"
                    android:scaleType="fitCenter"
                    android:src="@drawable/solarix_logo"
                    app:tint="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/register_title"
                    android:textColor="@color/slate_900"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="@string/register_tagline"
                    android:textColor="@color/slate_500"
                    android:textSize="12sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/register_name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_500"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/register_nic"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_500"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/register_email"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_500"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/register_phone"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_500"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/register_address"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_500"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:hint="@string/register_password"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            android:paddingVertical="0dp"
                            android:textColor="@color/slate_900"
                            android:textColorHint="@color/slate_500"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btnTogglePassword"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="14dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/register_toggle_password"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_visibility" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.72"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:hint="@string/register_confirm_password"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            android:paddingVertical="0dp"
                            android:textColor="@color/slate_900"
                            android:textColorHint="@color/slate_500"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btnToggleConfirmPassword"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="14dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/register_toggle_password"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_visibility" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/register_doc_label"
                    android:textColor="@color/slate_600"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectDoc"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/register_select_doc"
                    android:textAllCaps="false"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="999dp"
                    app:strokeColor="@color/booking_search_stroke"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/tvDocName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/register_no_doc"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/register_submit"
                    android:textAllCaps="false"
                    android:textColor="@color/slate_900"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/solarix_header"
                    app:cornerRadius="999dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_have_account"
                android:textColor="@color/slate_500"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvGoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:text="@string/register_login"
                android:textColor="@color/booking_eyebrow_amber"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
