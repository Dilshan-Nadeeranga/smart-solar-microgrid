<?xml version="1.0" encoding="utf-8"?>
<!-- Grid Operator: confirm and complete a verified reservation. States are switched in ConfirmTransactionActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:orientation="vertical"
    tools:context=".ui.operator.scan.ConfirmTransactionActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/qr_back"
            android:src="@drawable/ic_qr_back"
            app:tint="@color/op_text" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/confirm_title"
            android:textColor="@color/op_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/op_primary"
        app:trackColor="@color/op_amber_bg" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Review: verified reservation details. -->
            <LinearLayout
                android:id="@+id/reviewGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/OperatorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_operator_role_chip"
                            android:backgroundTint="@color/op_green_bg"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:text="@string/confirm_verified_chip"
                            android:textColor="@color/op_green_fg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_op_check_circle"
                            app:drawableTint="@color/op_green_fg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/confirm_subtitle"
                            android:textColor="@color/op_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            style="@style/OperatorSectionLabel"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="2dp"
                            android:layout_marginStart="0dp"
                            android:text="@string/confirm_label_station" />

                        <TextView
                            android:id="@+id/tvStation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/op_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Colombo Solar Hub" />

                        <TextView
                            style="@style/OperatorSectionLabel"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="2dp"
                            android:layout_marginStart="0dp"
                            android:text="@string/confirm_label_prosumer" />

                        <TextView
                            android:id="@+id/tvProsumer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/op_text"
                            android:textSize="15sp"
                            tools:text="Nimal Perera\nNIC 200012345678" />

                        <TextView
                            style="@style/OperatorSectionLabel"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="2dp"
                            android:layout_marginStart="0dp"
                            android:text="@string/confirm_label_slot" />

                        <TextView
                            android:id="@+id/tvSlot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/op_text"
                            android:textSize="15sp"
                            tools:text="Tue, Sep 29 · 10:00 AM – 11:00 AM" />

                        <TextView
                            style="@style/OperatorSectionLabel"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="2dp"
                            android:layout_marginStart="0dp"
                            android:text="@string/confirm_label_reservation" />

                        <TextView
                            android:id="@+id/tvReservationId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/op_text_secondary"
                            android:textIsSelectable="true"
                            android:textSize="13sp"
                            tools:text="66f9a1c2e4b0a1b2c3d4e5f6" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Error banner: same look as the operator home error card. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/errorCard"
                    style="@style/OperatorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/op_red_bg"
                    app:strokeColor="@color/op_red_border"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_op_error"
                            app:tint="@color/op_red_fg" />

                        <TextView
                            android:id="@+id/tvError"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="assertive"
                            android:textColor="@color/op_red_fg"
                            android:textSize="13sp"
                            tools:text="This booking was already completed." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Success: transfer recorded. -->
            <LinearLayout
                android:id="@+id/successGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_operator_icon_badge"
                    android:backgroundTint="@color/op_green_bg"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_op_check_circle"
                        app:tint="@color/op_green_fg" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSuccessTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityLiveRegion="assertive"
                    android:text="@string/confirm_done_title"
                    android:textColor="@color/op_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/confirm_done_message"
                    android:textColor="@color/op_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSuccessDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/op_text"
                    android:textSize="14sp"
                    tools:text="Colombo Solar Hub\nTue, Sep 29 · 10:00 AM – 11:00 AM" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom actions. Bottom padding is extended by the navigation bar inset in code. -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/confirm_complete"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:text="@string/confirm_cancel"
            android:textAllCaps="false"
            android:textColor="@color/op_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
